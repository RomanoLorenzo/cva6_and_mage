# File: mage-detach
# Description: CLI command to detach Mage CGRA from CVA6 SoC and restore pristine state.

import sys
import argparse
from pathlib import Path

# Add project root to sys.path
root_dir = Path(__file__).resolve().parent
sys.path.insert(0, str(root_dir))

from util.mage_soc_manager import MageSoCManager


def main():
    parser = argparse.ArgumentParser(
        description="Detach Mage CGRA from CVA6 SoC and restore pristine files."
    )
    parser.add_argument(
        "--status",
        "-s",
        action="store_true",
        help="Check current attachment status and exit.",
    )

    args = parser.parse_args()

    manager = MageSoCManager(root_dir=root_dir)

    if args.status:
        manager.status()
        sys.exit(0)

    try:
        manager.detach()
    except Exception as e:
        print(f"[ERROR] Failed to detach Mage: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()

