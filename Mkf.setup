# Assuming this Makefile is located in the CVA6 directory
# Assuming python3 is installed
# Assuming CMake version 3.14 or higher is installed

.PHONY: firstsetup

RISCV := $(CURDIR)/tools/riscv
INSTALL_DIR := $(RISCV)
VENV := $(CURDIR)/tools/venv
VERIBLE := $(CURDIR)/tools/verible
VERIBLE_VERSION := v0.0-4051-g9fdb4057
BENDER := $(CURDIR)/tools/bender
BENDER_VERSION := 0.27.1
GTKWAVE := $(CURDIR)/tools/gtkwave
NUM_JOBS := $(shell echo $$(( $$(nproc) * 2 / 3 )))

firstsetup:
	export NUM_JOBS

	@echo "[INFO] First setup after cloning the repo"

	@echo "[INFO] Updating git submodules"
	git submodule update --init --recursive

	@echo "[INFO] Installing dependencies"
	sudo apt-get update
	sudo apt-get install -y \
		autoconf \
		automake \
		autotools-dev \
		curl \
		git \
		libmpc-dev \
		libmpfr-dev \
		libgmp-dev \
		gawk \
		build-essential \
		bison \
		flex \
		texinfo \
		gperf \
		libtool \
		bc \
		zlib1g-dev \
		help2man \
		device-tree-compiler \
		libyaml-cpp-dev \
		libboost-system-dev \
		libboost-regex-dev \
		fusesoc \
		mako \
		hjson \
		jsonref \
		gtkwave \
		libboost-all-dev

	@echo "[INFO] Creating RISC-V toolchain directory"
	mkdir -p "$(RISCV)"

	@echo "[INFO] Fetching RISC-V toolchain source"
	RISCV="$(RISCV)" \
	INSTALL_DIR="$(INSTALL_DIR)" \
	bash ./util/toolchain-builder/get-toolchain.sh

	@echo "[INFO] Building and installing RISC-V toolchain"
	RISCV="$(RISCV)" \
	INSTALL_DIR="$(INSTALL_DIR)" \
	bash ./util/toolchain-builder/build-toolchain.sh "$(INSTALL_DIR)"

	@echo "[INFO] Setting up Python virtual environment"
	python3 -m venv "$(VENV)"
	"$(VENV)/bin/pip" install -r verif/sim/dv/requirements.txt

	@echo "[INFO] Setting up Spike"
	DV_SIMULATORS=veri-testharness,spike \
	bash verif/regress/smoke-tests-cv64a6_imafdc_sv39.sh

	@echo "[INFO] Installing Verible"
	mkdir -p "$(VERIBLE)"
	curl -fsSL "https://github.com/chipsalliance/verible/releases/download/$(VERIBLE_VERSION)/verible-$(VERIBLE_VERSION)-linux-static-x86_64.tar.gz" | tar -xz -C "$(VERIBLE)" --strip-components=1

	@echo "[INFO] Installing Bender"
	mkdir -p "$(BENDER)/bin"
	curl -fsSL "https://github.com/pulp-platform/bender/releases/download/v$(BENDER_VERSION)/bender-$(BENDER_VERSION)-x86_64-linux-gnu.tar.gz" | tar -xz -C "$(BENDER)/bin"
	chmod +x "$(BENDER)/bin/bender"

	@echo "[INFO] Setting up GTKWave in tools"
	mkdir -p "$(GTKWAVE)/bin"
	ln -sf /usr/bin/gtkwave "$(GTKWAVE)/bin/gtkwave"

